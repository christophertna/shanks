#!/bin/sh
# Same graph refresh as post-merge, run after `git checkout`/`git clone`.
# Args: $1 prev HEAD, $2 new HEAD, $3 1 if a branch checkout else 0. Skip
# when the tree didn't actually change (e.g. `checkout -b` off the current
# commit) so a fresh branch doesn't trigger a redundant rescan.
[ "$1" != "$2" ] || exit 0
# `${0%/*}` rather than `$(dirname "$0")`: a Git hook inherits whatever PATH
# invoked git, which need not contain coreutils - a runner whose git lives in
# /usr/local/bin has no `dirname` there, and this exec died with 126.
exec "${0%/*}/post-merge"
