#!/bin/sh
# Refresh the graphify knowledge graph after a pull/merge brings in new
# commits, since graphify-out/{graph.json,graph.html,GRAPH_REPORT.md,
# manifest.json,.graphify_labels.json} are generated and no longer tracked.
command -v graphify >/dev/null 2>&1 || exit 0
cd "$(git rev-parse --show-toplevel)" && graphify update . >/dev/null 2>&1
exit 0
